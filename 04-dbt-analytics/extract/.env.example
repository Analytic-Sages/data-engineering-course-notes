# Copy this file to .env and fill in your values.
# .env is gitignored — real keys never land in the repo.

# Ethereum mainnet RPC (Infura). Required by extract_swaps.py.
WEB3_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# PostgreSQL connection (defaults match docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blockchain_db
